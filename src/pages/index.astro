---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';

const servicii = [
  {
    href: u('/servicii#consultanta'),
    img: u('/img/consultanta.webp'),
    alt: 'Ședință de planificare cu planuri de sală și buget tipărite pe masă',
    script: 'prima direcție',
    titlu: 'Consultanță',
    meta: 'audit de concept · buget · plan de risc',
  },
  {
    href: u('/servicii#planner'),
    img: u('/img/planner.webp'),
    alt: 'Birou de organizator noaptea, cu minutar tipărit, plan de sală și bandă adezivă',
    script: 'a doua direcție',
    titlu: 'Planner',
    meta: 'concept · agendă pe minute · furnizori',
  },
  {
    href: u('/event-management'),
    img: u('/img/management.webp'),
    alt: 'Organizator la masa de regie, în lateralul scenei, în timpul unei conferințe',
    script: 'a treia direcție',
    titlu: 'Event Management',
    meta: 'tot, până la ultimul cablu strâns',
  },
];

const proiecte = [
  {
    img: u('/img/expo.webp'),
    alt: 'Hol de expoziție B2B cu standuri întunecate și vizitatori în mișcare',
    script: 'forum de industrie',
    titlu: 'Prima ediție, Iași',
    meta: '320 de participanți',
  },
  {
    img: u('/img/gala.webp'),
    alt: 'Sală de gală cu mese rotunde și lumină caldă, înainte de intrarea invitaților',
    script: 'gală de premiere',
    titlu: 'Ediția a patra, Bacău',
    meta: '210 invitați',
  },
  {
    img: u('/img/networking.webp'),
    alt: 'Pauză de cafea la o conferință, grupuri de oameni în discuție',
    script: 'lansare pentru parteneri',
    titlu: 'Rețea de distribuție, București',
    meta: '140 de parteneri',
  },
];

const minutar = [
  ['07:30', 'Acces echipă în sală. Verific curentul pe scenă, internetul pe cablu și cine are cheile de la ușa de serviciu.'],
  ['08:10', 'Test sonor și proiecție. Două microfoane de rezervă rămân pe masa de regie, încărcate.'],
  ['08:40', 'Deschidere înregistrare. Două posturi pentru participanți, unul separat pentru presă și speakeri.'],
  ['09:15', 'Cuvânt de deschidere, 4 minute. Cronometrat de la regie, nu de la scenă.'],
  ['09:20', 'Panel 1, 45 de minute. Apa se schimbă la pauza tehnică de la minutul 25.'],
  ['10:05', 'Coffee break, 25 de minute. Cateringul intră pe ușa de serviciu, nu prin holul cu participanți.'],
  ['13:00', 'Prânz. Sala se resetează în paralel: scaune, sonorizare pentru sesiunea de după-amiază.'],
  ['16:30', 'Sesiune de networking. Lumina scade cu două trepte, muzica intră la -18 dB.'],
  ['17:40', 'Demontaj. Inventar de echipamente și proces-verbal semnat cu locația înainte să plece cineva.'],
];

const furnizori = [
  ['Sonorizare, proiecție, traducere simultană', '11 furnizori'],
  ['Lumini și scenotehnică', '8 furnizori'],
  ['Mobilier, decor, aranjamente', '14 furnizori'],
  ['Structuri, corturi, pardoseli, generatoare', '6 furnizori'],
  ['Catering și bar', '19 furnizori'],
  ['Print, signalistică, branding de spațiu', '9 furnizori'],
  ['Foto, video, streaming', '12 furnizori'],
  ['Transport, hostess, pază, garderobă', '11 furnizori'],
];

const proces = [
  ['01', 'Brief și obiectiv', 'O ședință de 90 de minute. Ce vrei să se întâmple după eveniment, nu în timpul lui. Dacă nu putem răspunde la asta, nu trecem mai departe.'],
  ['02', 'Concept și buget pe capitole', 'Primești un document cu formatul propus și bugetul spart pe capitole. Vezi de la început unde se duc banii și ce se poate tăia fără să se vadă.'],
  ['03', 'Contractare', 'Cer oferte de la minimum trei furnizori pe fiecare capitol important. Le primești așa cum vin, cu comparația alături.'],
  ['04', 'Producție și repetiție tehnică', 'Cronologie pe săptămâni. Repetiția tehnică se face cu o zi înainte, cu speakerii care pot veni.'],
  ['05', 'Ziua Z și decont', 'Sunt în sală de la primul om care intră până la ultimul cablu strâns. La final primești decontul pe capitole și inventarul semnat.'],
];

const faq = [
  {
    q: 'Cât costă?',
    a: 'Consultanța pornește de la 4.800 lei pe proiect. Planner și Event Management se calculează ca onorariu fix, între 9.000 și 28.000 lei, sau 8-12% din bugetul de producție la evenimentele peste 150.000 lei. Onorariul e trecut separat de bugetul de producție, ca să vezi exact ce plătești furnizorilor și ce plătești mie.',
  },
  {
    q: 'Lucrezi doar în Bacău?',
    a: 'Sunt din Bacău și de aici pornesc, dar jumătate din evenimente sunt în afara județului: Iași, Piatra Neamț, Brașov, Cluj, București. Deplasarea și cazarea intră în buget ca linie separată, nu ascunsă în onorariu.',
  },
  {
    q: 'Cu cât timp înainte trebuie să te contactez?',
    a: 'Zece-douăsprezece săptămâni pentru o conferință de peste 150 de participanți. Sub șase săptămâni accept doar dacă locația e deja rezervată și bugetul e aprobat.',
  },
  {
    q: 'Pot să-mi păstrez furnizorii cu care lucrez deja?',
    a: 'Da, și e de preferat. Îi integrez în cronologie și lucrez cu ei ca și cu ai mei. Rețeaua mea acoperă doar ce lipsește.',
  },
  {
    q: 'Pe numele cui se semnează contractele cu furnizorii?',
    a: 'Pe numele companiei tale. Eu negociez și coordonez, dar relația contractuală și facturile rămân directe. Așa vezi prețul real și rămâi cu furnizorii și după ce terminăm.',
  },
  {
    q: 'Ce se întâmplă dacă pică un furnizor cu trei zile înainte?',
    a: 'Pe capitolele critice (sonorizare, lumini, catering) am al doilea nume confirmat verbal încă de la contractare. S-a întâmplat de patru ori în nouă ani; de fiecare dată evenimentul a început la ora din agendă.',
  },
];
---

<Base
  title="Eduard Crenganiș · organizator de evenimente B2B în Bacău"
  description="Consultanță, planning și event management pentru conferințe, summit-uri și evenimente corporate. Din Bacău, în toată țara. Contractarea și coordonarea furnizorilor incluse."
>
  <!-- ================= HERO ================= -->
  <section class="hero">
    <div class="hero__media">
      <img
        src={u('/img/hero-sala.webp')}
        alt="Sală de conferință în semiîntuneric, participanți văzuți din spate, scenă luminată în depărtare"
        width="2400"
        height="1029"
        fetchpriority="high"
        decoding="async"
      />
    </div>

    <div class="hero__inner">
      <p class="hero__script">organizator de evenimente</p>
      <h1>
        Evenimente B2B ținute strâns, <br class="br-lg" />
        de la brief până la demontare.
      </h1>
      <p class="lede hero__lede">
        Consultanță, planificare și management de eveniment pentru companii, asociații
        profesionale și organizatori de conferințe. Din Bacău, în toată țara. Lucrez cu un
        minutar, un buget spart pe capitole și o listă de furnizori pe care le vezi și tu.
      </p>
      <div class="hero__cta">
        <a class="btn btn--solid" href="#contact">Cere o ofertă</a>
        <a class="btn btn--ghost" href={u('/servicii')}>Vezi serviciile</a>
      </div>
    </div>

    <div class="hero__facts">
      <span>9 ani în producție de evenimente</span>
      <span>140 de evenimente coordonate</span>
      <span>de la 60 la 1.200 de participanți</span>
      <span>90 de furnizori verificați</span>
    </div>
  </section>

  <!-- ================= DESPRE ================= -->
  <section class="section section--paper" id="despre">
    <div class="wrap despre">
      <figure class="despre__foto">
        <div class="portret">
          <div class="portret__inner">
            <img
              src={u('/img/eduard-portret.webp')}
              alt="Eduard Crenganiș, organizator de evenimente"
              width="1100"
              height="1100"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </figure>

      <div class="despre__text">
        <p class="eyebrow">cine sunt</p>
        <h2>Eduard Crenganiș, organizator de evenimente. Din Bacău.</h2>
        <p>
          Am început în producție, nu în birou: cabluri, structuri, montaje care se terminau la
          patru dimineața. Nouă ani mai târziu, partea aia încă e motivul pentru care știu cât
          durează cu adevărat un montaj și de ce nu se poate „repede, până la 8".
        </p>
        <p>
          Astăzi lucrez singur pe strategie și coordonare și strâng echipa de producție pentru
          fiecare proiect. Vorbești cu omul care ia deciziile, nu cu un account manager care le
          transmite mai departe. În ziua evenimentului sunt în sală, nu pe telefon.
        </p>
        <p>
          Baza e la Bacău. Jumătate din evenimente sunt în afara județului, de la Iași și
          Piatra Neamț până la Cluj și București.
        </p>

        <p class="despre__semnatura mono">
          Bacău · lucrez în toată țara<br />
          <a class="ulink" href="tel:+40741208336">+40 741 208 336</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ================= SERVICII ================= -->
  <section class="section" id="servicii">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">trei direcții</p>
        <h2>Alegi cât predai și cât ții la tine.</h2>
        <p>
          Poți intra pe oricare dintre ele și poți urca de la una la alta pe parcurs. Divizia
          de închirieri și subcontractări intră în pachetul de Event Management.
        </p>
      </div>

      <div class="cards cards--3">
        {servicii.map((s) => (
          <a class="card" href={s.href}>
            <img src={s.img} alt={s.alt} loading="lazy" decoding="async" width="1600" height="1200" />
            <span class="card__label">
              <span class="card__script">{s.script}</span>
              <span class="card__title">{s.titlu}</span>
              <span class="card__meta">{s.meta}</span>
            </span>
          </a>
        ))}
      </div>

      <p style="margin-top:2.25rem;">
        <a class="ulink" href={u('/servicii')}>Ce include fiecare direcție, în detaliu</a>
      </p>
    </div>
  </section>

  <hr class="rule" />

  <!-- ================= MINUTAR ================= -->
  <section class="section" id="minutar">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">documentul de lucru</p>
        <h2>Așa arată o zi de eveniment scrisă înainte să înceapă.</h2>
        <p>
          Fragment din minutarul unui forum de industrie cu 320 de participanți. Îl primești
          cu o săptămână înainte, îl are fiecare furnizor pe telefon, iar în ziua Z e singurul
          document după care se lucrează.
        </p>
      </div>

      <div class="minutar">
        <ol class="rundown">
          {minutar.map(([ora, ce]) => (
            <li>
              <span class="rundown__ora">{ora}</span>
              <span class="rundown__ce">{ce}</span>
            </li>
          ))}
        </ol>

        <figure>
          <div class="shot shot--tall">
            <img src={u('/img/minutar.webp')} alt="Minutar tipărit, cu note scrise de mână pe margine și un rând marcat" loading="lazy" decoding="async" width="1600" height="1067" />
          </div>
          <figcaption>Fig. 04 · minutarul de la ora 06:50, cu notele de la repetiția tehnică</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <hr class="rule" />

  <!-- ================= FURNIZORI ================= -->
  <section class="section" id="furnizori">
    <div class="wrap furn">
      <div>
        <div class="head">
          <p class="eyebrow">închirieri și subcontractări</p>
          <h2>Divizia de furnizori intră în pachetul de Event Management.</h2>
          <p>
            Nu am depozit propriu și nu vând echipamente. Am o rețea de furnizori cu care
            lucrez de ani buni, de la care cer oferte, cu care negociez și pe care îi
            coordonez la montaj. Contractele se semnează pe numele tău.
          </p>
        </div>

        <dl class="deviz">
          {furnizori.map(([cat, nr]) => (
            <div class="deviz__row">
              <dt>{cat}</dt>
              <dd>{nr}</dd>
            </div>
          ))}
        </dl>

        <p class="nota">
          Pe fiecare capitol important cer minimum trei oferte și ți le trimit așa cum vin,
          cu comparația alături. Comisionul meu e trecut separat, nu ascuns în prețul
          furnizorului.
        </p>
      </div>

      <figure class="furn__media">
        <div class="shot shot--tall">
          <img src={u('/img/depozit.webp')} alt="Depozit de echipamente de eveniment noaptea, cu flight case-uri și structuri de aluminiu" loading="lazy" decoding="async" width="1600" height="1067" />
        </div>
        <figcaption>Fig. 05 · depozitul unui furnizor de scenotehnică, la preluare</figcaption>
      </figure>
    </div>
  </section>

  <!-- ================= PORTOFOLIU (teaser) ================= -->
  <section class="section section--paper">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">din portofoliu</p>
        <h2>Trei evenimente și ce a rămas după ele.</h2>
      </div>

      <div class="cards cards--3">
        {proiecte.map((p) => (
          <a class="card" href={u('/portofoliu')}>
            <img src={p.img} alt={p.alt} loading="lazy" decoding="async" width="1600" height="1200" />
            <span class="card__label">
              <span class="card__script">{p.script}</span>
              <span class="card__title">{p.titlu}</span>
              <span class="card__meta">{p.meta}</span>
            </span>
          </a>
        ))}
      </div>

      <p style="margin-top:2.25rem;">
        <a class="ulink" href={u('/portofoliu')}>Vezi portofoliul complet</a>
      </p>
    </div>
  </section>

  <!-- ================= PROCES ================= -->
  <section class="section" id="proces">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">cum lucrăm</p>
        <h2>Cinci etape, fiecare cu un document la capăt.</h2>
      </div>

      <ol class="etape">
        {proces.map(([nr, titlu, text]) => (
          <li>
            <span class="etape__nr">{nr}</span>
            <div>
              <h3>{titlu}</h3>
              <p>{text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ================= POTRIVIRE ================= -->
  <section class="section">
    <div class="wrap potrivire">
      <div>
        <h3>Lucrăm bine împreună dacă</h3>
        <ul class="list">
          <li>Faci una până la patru evenimente pe an și nu ai departament dedicat.</li>
          <li>Ești asociație sau organizație profesională și organizezi pentru membri.</li>
          <li>Ai deja o echipă de marketing care poate prelua comunicarea, dar nu producția.</li>
          <li>Vrei să știi exact unde se duce fiecare linie din buget.</li>
        </ul>
      </div>
      <div>
        <h3>Nu sunt omul potrivit dacă</h3>
        <ul class="list list--no">
          <li>Cauți nunți, botezuri sau petreceri private. Nu fac evenimente de familie.</li>
          <li>Bugetul de producție e sub 25.000 de lei. La suma asta nu pot ține standardul de mai sus și îți spun de la început.</li>
          <li>Vrei „ceva frumos, vedem noi pe parcurs”. Fără obiectiv scris, nu pornesc.</li>
          <li>Ai nevoie de cineva care semnează contractele în locul tău.</li>
        </ul>
      </div>
    </div>
  </section>

  <hr class="rule" />

  <!-- ================= FAQ ================= -->
  <section class="section" id="intrebari">
    <div class="wrap wrap--narrow">
      <div class="head">
        <p class="eyebrow">întrebări</p>
        <h2>Ce mă întreabă toți, înainte de prima ședință.</h2>
      </div>

      <div class="faq">
        {faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <div class="faq__a"><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= CONTACT ================= -->
  <section class="contact" id="contact">
    <div class="wrap contact__grid">
      <div>
        <div class="head">
          <p class="eyebrow">contact</p>
          <h2>Spune-mi ce eveniment ai în cap.</h2>
          <p>
            Răspund în aceeași zi lucrătoare. Dacă e mai simplu, sună direct sau scrie pe
            WhatsApp; formularul de aici deschide tot o conversație pe WhatsApp, cu datele
            deja completate.
          </p>
        </div>

        <div class="contact__direct">
          <a class="ulink" href="tel:+40741208336">+40 741 208 336</a>
          <a class="ulink" href="mailto:eduard@crenganis.ro">eduard@crenganis.ro</a>
        </div>

        <figure style="margin-top:2.5rem;">
          <div class="shot shot--wide">
            <img src={u('/img/montaj-sala.webp')} alt="Sală de conferință pregătită, cu scaunele aliniate înainte de intrarea participanților" loading="lazy" decoding="async" width="1600" height="900" />
          </div>
          <figcaption>Fig. 06 · sala la 08:30, înainte de primul participant</figcaption>
        </figure>
      </div>

      <form class="form" id="brief-form" novalidate>
        <div class="field">
          <label for="nume">Nume</label>
          <input id="nume" name="nume" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="companie">Companie sau organizație</label>
          <input id="companie" name="companie" type="text" autocomplete="organization" />
        </div>
        <div class="field">
          <label for="tip">Tip de eveniment</label>
          <select id="tip" name="tip">
            <option>Conferință sau forum</option>
            <option>Summit / expo-conferință</option>
            <option>Lansare de produs pentru parteneri</option>
            <option>Gală sau dineu corporate</option>
            <option>Training, offsite, team building</option>
            <option>Încă nu știu</option>
          </select>
        </div>
        <div class="field field--split">
          <div>
            <label for="data">Data estimată</label>
            <input id="data" name="data" type="text" placeholder="ex. mai 2027" />
          </div>
          <div>
            <label for="participanti">Participanți</label>
            <input id="participanti" name="participanti" type="text" placeholder="ex. 250" />
          </div>
        </div>
        <div class="field">
          <label for="mesaj">Ce vrei să obții din eveniment</label>
          <textarea id="mesaj" name="mesaj" rows="4"></textarea>
        </div>

        <button class="btn btn--solid" type="submit">Trimite pe WhatsApp</button>
        <p class="mono" style="margin-top:1rem;">
          Demo · formularul deschide WhatsApp cu mesajul precompletat
        </p>
      </form>
    </div>
  </section>
</Base>

<script>
  const form = document.getElementById('brief-form') as HTMLFormElement | null;

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = new FormData(form);
    const linii = [
      'Bună ziua, vă scriu de pe site.',
      '',
      `Nume: ${d.get('nume') || '-'}`,
      `Companie: ${d.get('companie') || '-'}`,
      `Tip eveniment: ${d.get('tip') || '-'}`,
      `Data estimată: ${d.get('data') || '-'}`,
      `Participanți: ${d.get('participanti') || '-'}`,
      '',
      `${d.get('mesaj') || ''}`,
    ];
    window.open(`https://wa.me/40741208336?text=${encodeURIComponent(linii.join('\n'))}`, '_blank', 'noopener');
  });
</script>

<style>
  .br-lg { display: none; }
  @media (min-width: 900px) { .br-lg { display: inline; } }

  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    min-height: min(92svh, 54rem);
    display: grid;
    align-content: end;
    padding: clamp(6rem, 14vh, 10rem) var(--gutter) 0;
    isolation: isolate;
  }

  .hero__media { position: absolute; inset: 0; z-index: -2; }
  .hero__media img { width: 100%; height: 100%; object-fit: cover; object-position: center 42%; }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, var(--ink) 4%, rgba(11, 10, 9, 0.72) 46%, rgba(11, 10, 9, 0.45) 100%),
      linear-gradient(to right, rgba(11, 10, 9, 0.8) 0%, rgba(11, 10, 9, 0.1) 62%);
  }

  .hero__inner { max-width: 68rem; margin-inline: auto; width: 100%; }
  .hero__script {
    font-family: var(--font-script);
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    line-height: 1;
    color: var(--brass);
    margin: 0 0 1.1rem;
  }
  .hero__lede { max-width: 38rem; margin-top: 1.9rem; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 0.85rem; margin-top: 2.4rem; }

  .hero__facts {
    max-width: 68rem;
    margin: clamp(3rem, 7vh, 5rem) auto 0;
    width: 100%;
    display: grid;
    gap: 0.55rem 2.5rem;
    padding-block: 1.15rem;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--paper-3);
    letter-spacing: 0.01em;
  }
  @media (min-width: 760px) {
    .hero__facts { grid-template-columns: repeat(4, auto); justify-content: space-between; }
  }

  /* ---------- Despre ---------- */
  .despre { display: grid; gap: 2.5rem; align-items: center; }
  .despre__foto { margin: 0; display: flex; justify-content: center; }
  .despre__text h2 {
    font-size: clamp(1.75rem, 3vw, 2.6rem);
    margin: 0.2rem 0 1.4rem;
  }
  .despre__semnatura {
    margin-top: 2rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line-paper);
    line-height: 1.9;
  }
  @media (min-width: 880px) {
